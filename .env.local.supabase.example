# App runtime values for a local Supabase stack.
# Run `bunx supabase status` after `bunx supabase start` and paste the local anon key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GITHUB_OAUTH_SCOPE=repo
VITE_GITHUB_OAUTH_REDIRECT_URL=http://localhost:5173/

# Supabase CLI local Auth provider values.
# Create a dedicated GitHub OAuth App with this Authorization callback URL:
# http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
