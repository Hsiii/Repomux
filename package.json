{
    "name": "repomux",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky",
        "setup:codex": "bun scripts/setup-repomux-codex-automation.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check": "tsc -p tsconfig.json --noEmit && eslint . && prettier . --check && next build"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,css,scss,html,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@vercel/analytics": "2.0.1",
        "@tanstack/react-query": "5.100.11",
        "lucide-react": "1.17.0",
        "next": "^16.2.9",
        "react": "19.2.6",
        "react-dom": "19.2.6"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.3",
        "complete-lint": "5.11.0",
        "eslint": "10.4.0",
        "eslint-config-complete": "4.7.2",
        "eslint-import-resolver-typescript": "4.4.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "3.8.3",
        "typescript": "6.0.3",
        "vercel": "54.9.1"
    },
    "packageManager": "bun@1.3.9"
}
