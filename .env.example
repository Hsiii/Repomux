NEXT_PUBLIC_GITHUB_OAUTH_SCOPE=repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: override the callback URL instead of using /api/github/callback on the current origin.
GITHUB_OAUTH_REDIRECT_URI=

# Optional: use a separate GitHub OAuth App for localhost development.
# Set that app's callback URL to http://localhost:3000/api/github/callback.
GITHUB_DEV_CLIENT_ID=
GITHUB_DEV_CLIENT_SECRET=
GITHUB_DEV_OAUTH_REDIRECT_URI=
